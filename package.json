{
  "name": "workout-tracker",
  "version": "0.1.0",
  "license": "ISC",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "design": "vite --mode design --host 127.0.0.1 --port 4180 --strictPort",
    "build:design": "vite build --mode design",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test tests/learning-baseline.cjs && vitest run",
    "test:e2e": "playwright test",
    "test:design": "playwright test --config playwright.design.config.ts",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "workbox-build": {
      "glob": "^14.0.6"
    }
  },
  "dependencies": {
    "@fontsource/barlow-semi-condensed": "^5.2.0",
    "@fontsource/inter": "^5.2.0",
    "idb": "^8.0.3",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fake-indexeddb": "^6.0.0",
    "globals": "^16.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.50.0",
    "vite": "^7.3.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.0"
  }
}
